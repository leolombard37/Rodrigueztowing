# Supabase Configuration (existing)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Notifications (Resend)
# Get API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx

# From email address (use onboarding@resend.dev for testing)
FROM_EMAIL=Rodriguez Towing <onboarding@resend.dev>

# Email address to receive business notifications
BUSINESS_EMAIL=owner@rodrigueztowing.com

# SMS Notifications (Twilio)
# Get credentials at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Phone numbers to receive urgent SMS alerts (comma-separated)
ALERT_PHONE_NUMBERS=+15027930829,+19293738832
